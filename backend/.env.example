# FocusGuard Backend Environment Configuration
PROJECT_NAME="FocusGuard Backend"
API_V1_STR="/api/v1"

# Database Configuration (Defaults to SQLite for instant local dev/test if Postgres is offline)
# When using Docker Compose: postgresql://focusguard:focusguard_secure_password@localhost:5432/focusguard
DATABASE_URL="sqlite:///./focusguard.db"

# JWT Authentication
JWT_SECRET="focusguard_super_secret_jwt_key_change_in_production_32char_min"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# AI Provider Configuration (Called strictly from backend, never exposed to client)
GEMINI_API_KEY=""
AI_MODEL_NAME="gemini-1.5-flash"

# Security & CORS
CORS_ORIGINS=["*"]
RATE_LIMIT_PER_MINUTE=120
